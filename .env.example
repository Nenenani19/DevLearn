# Public values are safe to expose to the browser. Get these from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The site URL used to build email verification / password reset
# redirect links. Set to http://localhost:3000 in local dev and
# your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER exposed to the client, NEVER committed.
# Only needed if you later write server-side admin scripts
# (e.g. a seed script). Not used by the app at runtime.
# SUPABASE_SERVICE_ROLE_KEY=
